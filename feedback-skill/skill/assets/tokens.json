{
  "name": "Feedback Design",
  "version": "1.0.0",
  "colors": {
    "coral": "#F04D51",
    "cyan": "#0BB0D2",
    "ink": "#111111",
    "white": "#FFFFFF",
    "muted": "#6C7277",
    "line": "#E4E6E6"
  },
  "typography": {
    "heading": "Baskerville MT Std Regular",
    "body": "Akzidenz-Grotesk Pro",
    "heading_fallback": "Georgia",
    "body_fallback": "Arial, Helvetica, sans-serif"
  },
  "layout": {
    "background": "white",
    "grid": "modular",
    "balance": "asymmetric",
    "arrow": "large geometric",
    "gradients": false,
    "ragged_edges": false
  },
  "collage": {
    "photography": "black and white",
    "focal_faces": "avoid unless expressly requested",
    "framing": "details, backs, hands and distance",
    "crops": "sharp precise",
    "territory": "verified documentary sources",
    "transparency": "true alpha when requested"
  },
  "presentation": {
    "default_ratio": "16:9",
    "preserve_content": true,
    "preserve_slide_count": true,
    "editable_native_elements_when_requested": true
  }
}
